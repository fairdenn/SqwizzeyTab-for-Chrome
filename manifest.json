{
  "manifest_version": 3,
  "name": "Sqwizzey Tab",
  "description": "A new-tab replacement — a visual bookmark manager with boards, pages, drag-and-drop and live Chrome bookmark-folder sync.",
  "version": "2.10.1",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Sqwizzey Tab",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "tabs",
    "favicon",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/",
    "http://*/"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Sqwizzey Tab"
}